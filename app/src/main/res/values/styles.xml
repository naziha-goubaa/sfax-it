<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.ApplicationMobile5" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#2196F3</item>
        <item name="colorPrimaryVariant">#1976D2</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#03DAC5</item>
        <item name="colorSecondaryVariant">#018786</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Surface colors -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#212121</item>

        <!-- Background colors -->
        <item name="android:colorBackground">#F8FAFF</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#1976D2</item>

        <!-- Elevation overlays -->
        <item name="android:elevation">4dp</item>

        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MaterialComponents.Button.OutlinedButton</item>

        <!-- Text input styles -->
        <item name="materialTextFieldStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>

        <!-- Card view -->
        <item name="cardViewStyle">@style/CardViewStyle</item>
    </style>

    <!-- Menu item style -->
    <style name="MenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Card view style -->
    <style name="CardViewStyle" parent="CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">8dp</item>
    </style>

    <!-- Custom button style -->
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Outlined button style -->
    <style name="OutlinedButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#2196F3</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>